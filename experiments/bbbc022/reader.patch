 }
 
+static int
+test_batch_handles_and_advice(void)
+{
+  const char* modes[] = {
+    "persistent-default", "persistent-random", "batch-default", "batch-random"
+  };
+  char root[] = "/tmp/damacy_store_fs_modes_XXXXXX";
+  EXPECT(mkdtemp(root));
+  EXPECT(setup_files(root, 1) == 0);
+  struct store_fs_config cfg = { .root = root,
+                                 .nthreads = 2,
+                                 .fd_cache_capacity = CAP };
+  for (unsigned mode = 0; mode < 4; ++mode) {
+    EXPECT(setenv("DAMACY_BENCH_READ_MODE", modes[mode], 1) == 0);
+    struct store* store = store_fs_create(&cfg);
+    EXPECT(store);
+    struct store_fs* fs = (struct store_fs*)store;
+    struct store_fs_batch* batches[2] = { 0 };
+    for (unsigned i = 0; i < 2; ++i) {
+      EXPECT(store_fs_batch_begin(store, 1, &batches[i]) == DAMACY_OK);
+      EXPECT((batches[i] != NULL) == (mode >= 2));
+    }
+    char output[2] = { 0 };
+    struct store_event events[2];
+    for (unsigned i = 0; i < 2; ++i) {
+      struct store_read read = { .key = "k0", .dst = output + i, .len = 1 };
+      struct store_submit_result result =
+        store_fs_batch_submit(store, batches[i], &read, 1);
+      EXPECT(result.status == DAMACY_OK);
+      events[i] = result.event;
+    }
+    for (unsigned i = 0; i < 2; ++i) {
+      EXPECT(store_event_wait(store, events[i]) == DAMACY_OK);
+      EXPECT(output[i] == 'a');
+    }
+    struct store_fs_io_stats stats;
+    store_fs_io_stats_get(fs, &stats);
+    EXPECT(stats.opens == (mode >= 2 ? 2 : 1));
+    EXPECT(stats.random_advice_calls == (mode % 2 ? stats.opens : 0));
+    EXPECT(stats.random_advice_errors == 0);
+    EXPECT(stats.open_files == stats.opens);
+    EXPECT(stats.closes == 0);
+    EXPECT(stats.active_batches == (mode >= 2 ? 2 : 0));
+    store_fs_batch_end(batches[0]);
+    store_fs_io_stats_get(fs, &stats);
+    EXPECT(stats.closes == (mode >= 2 ? 1 : 0));
+    struct store_read read = { .key = "k0", .dst = output, .len = 1 };
+    struct store_submit_result result =
+      store_fs_batch_submit(store, batches[1], &read, 1);
+    EXPECT(result.status == DAMACY_OK);
+    EXPECT(store_event_wait(store, result.event) == DAMACY_OK);
+    store_fs_io_stats_get(fs, &stats);
+    EXPECT(stats.opens == (mode >= 2 ? 2 : 1));
+    EXPECT(output[0] == 'a');
+    store_fs_batch_end(batches[1]);
+    struct store_fs_batch* next = NULL;
+    EXPECT(store_fs_batch_begin(store, 1, &next) == DAMACY_OK);
+    result = store_fs_batch_submit(store, next, &read, 1);
+    EXPECT(result.status == DAMACY_OK);
+    EXPECT(store_event_wait(store, result.event) == DAMACY_OK);
+    store_fs_batch_end(next);
+    store_fs_io_stats_get(fs, &stats);
+    EXPECT(stats.read_jobs == 4);
+    EXPECT(stats.opens == (mode >= 2 ? 3 : 1));
+    EXPECT(stats.closes == (mode >= 2 ? 3 : 0));
+    EXPECT(stats.open_files == (mode >= 2 ? 0 : 1));
+    EXPECT(stats.max_open_files == (mode >= 2 ? 2 : 1));
+    EXPECT(stats.active_batches == 0);
+    EXPECT(stats.batches_created == (mode >= 2 ? 3 : 0));
+    EXPECT(stats.batches_created == stats.batches_destroyed);
+    EXPECT(stats.random_advice_calls == (mode % 2 ? stats.opens : 0));
+    store_destroy(store);
+  }
+  EXPECT(setenv("DAMACY_BENCH_READ_MODE", "invalid", 1) == 0);
+  EXPECT(store_fs_create(&cfg) == NULL);
+  EXPECT(unsetenv("DAMACY_BENCH_READ_MODE") == 0);
+  char path[256];
+  snprintf(path, sizeof(path), "%s/k0", root);
+  EXPECT(unlink(path) == 0);
+  EXPECT(rmdir(root) == 0);
+  return 0;
+}
+
 int
 main(void)
 {
+  RUN(test_batch_handles_and_advice);
   RUN(test_bounded_eviction);
   RUN(test_hit_path);
   RUN(test_pin_saturation);

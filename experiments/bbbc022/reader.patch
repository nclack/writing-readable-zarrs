+                     struct store_fs_batch** out)
+{
+  *out = NULL;
+  if (!s || s->vt != &fs_vtable_host)
+    return DAMACY_OK;
+  struct store_fs* fs = (struct store_fs*)s;
+  if (!fs->batch_handles)
+    return DAMACY_OK;
+  if (!max_files)
+    return DAMACY_INVAL;
+  struct store_fs_batch* batch = calloc(1, sizeof(*batch));
+  if (!batch)
+    return DAMACY_OOM;
+  batch->fs = fs;
+  struct lru_ops ops = { .eq = fs_cache_eq,
+                         .destroy = fs_cache_destroy,
+                         .user = fs };
+  uint32_t capacity =
+    max_files < fs->fd_cache_capacity ? max_files : fs->fd_cache_capacity;
+  batch->cache = lru_create(capacity, FS_FD_CACHE_MAX_PROBE, &ops);
+  if (!batch->cache) {

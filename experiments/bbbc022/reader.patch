+void
+store_fs_batch_end(struct store_fs_batch* batch)
+{
+  if (!batch)
+    return;
+  struct store_fs* fs = batch->fs;
+  platform_mutex_lock(fs->cache_lock);
+  struct lru_stats stats;
+  lru_stats_get(batch->cache, &stats);
+  if (stats.pinned)
+    abort();
+  lru_destroy(batch->cache);
+  platform_mutex_unlock(fs->cache_lock);
+  atomic_fetch_add_explicit(&fs->batches_destroyed, 1, memory_order_relaxed);
+  atomic_fetch_sub_explicit(&fs->active_batches, 1, memory_order_relaxed);
+  free(batch);
+}
